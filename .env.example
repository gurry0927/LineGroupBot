# LINE Bot credentials
# Get from LINE Developers Console → Your Channel → Basic Settings
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Immich instance
# Your self-hosted Immich URL and API key
IMMICH_URL=https://your-immich.example.com
IMMICH_API_KEY=

# Database path (absolute path inside container; must point at the mounted volume)
DB_PATH=/app/data/bot.db

# No deploy secret needed — deploy by rebuilding the container:
#   git pull && docker compose up -d --build
